{
  "name": "@nfx/test-player",
  "private": true,
  "type": "module",
  "description": "A2 test player: hls.js over an NFX-05 \u00a76 origin, every file verified against its sha256 and the hash list before hls.js sees it",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "esbuild src/player.ts --bundle --format=esm --target=es2022 --outdir=out",
    "serve": "esbuild src/player.ts --bundle --format=esm --target=es2022 --outdir=out --servedir=. --serve=0.0.0.0:3471",
    "e2e": "tsx e2e.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.25.10",
    "hls.js": "1.7.3",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
