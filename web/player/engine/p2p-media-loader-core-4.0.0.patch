+/** What a `signalingClientFactory` is given for one stream swarm. */
+export type SignalingClientContext = {
+  /** The swarm's infohash, as trackers would be told. */
+  infoHash: string;
+
+  /** The stream swarm ID the infohash is computed from. */
+  streamSwarmId: string;
+
+  /** This peer's ID, as trackers would be told. */
+  peerId: string;
+
+  /** The RTC configuration to create peer connections with (read it for each). */
+  rtcConfig: () => RTCConfiguration | undefined;
+
+  /** The data channel configuration, if any. */
+  channelConfig?: RTCDataChannelInit;
+
+  /**
+   * Claim a remote peer before negotiating with it: false when that peer is already
+   * connecting or connected, or the swarm is full. A claim ends with the client's
+   * `peerConnected` or `peerConnectFailed` event for that peer.
+   */
+  claimPeer: (peerId: string) => boolean;
+
+  /** Whether the swarm wants more peers (offers are made only while it does). */
+  shouldGenerateOffers: () => boolean;
+
+  /** How long an offer waits for its answer, in milliseconds. */
+  offerTimeout?: () => number;
+
+  /** How long ICE gathering may take, in milliseconds. */
+  iceGatheringTimeout?: () => number;
+
+  /** How long the data channel may take to open after signaling, in milliseconds. */
+  connectionTimeout?: () => number;
+};
+
+/** The events a signaling client reports, as a WebTorrent tracker client does. */
+export type SignalingClientEventMap = {
+  peerConnected: (event: {
+    peerId: string;
+    connection: RTCPeerConnection;
+    channel: RTCDataChannel;
+  }) => void;
+  peerConnectFailed: (event: {
+    peerId: string;
+    error: PeerConnectError;
+  }) => void;
+  warning: (warning: TrackerWarning) => void;
+  error: (error: TrackerError) => void;
+};
+
+/** A stream swarm's signaling client (see `signalingClientFactory`). */
+export interface SignalingClient {
+  /** Names the signaling service where events would name a tracker URL. */
+  readonly url: string;
+
+  addEventListener<K extends keyof SignalingClientEventMap>(
+    eventName: K,
+    listener: SignalingClientEventMap[K],
+  ): void;
+
+  removeEventListener<K extends keyof SignalingClientEventMap>(
+    eventName: K,
+    listener: SignalingClientEventMap[K],
+  ): void;
+
+  /** Start finding peers. Called once. */
+  start(): void;
+
+  /**
+   * Stop: close every connection still negotiating and send no further events.
+   * Connections already reported by `peerConnected` belong to the core.
+   */
+  destroy(): void;
+}
+
+/** Makes the signaling client of one stream swarm. */
+export type SignalingClientFactory = (
+  context: SignalingClientContext,
+) => SignalingClient;
