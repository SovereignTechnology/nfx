+        event.connection,
+        event.channel,
+        url,
+      );
+    };
+
+    const onPeerConnectFailed = (event: {
+      peerId: string;
+      error: PeerConnectError;
+    }) => {
+      if (this.#connectingPeers.has(event.peerId)) {
+        this.#connectingPeers.delete(event.peerId);
