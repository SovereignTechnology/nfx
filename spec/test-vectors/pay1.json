{
  "description": "NFX-07 §2 pay/1 messages: one JSON object per line (NDJSON), at most 32 KiB with its newline. Every 'valid' wire parses to its 'message' (unknown fields dropped); every 'invalid' wire MUST be refused.",
  "max_line_bytes": 32768,
  "valid": [
    {
      "name": "hello",
      "wire": "{\"t\":\"hello\",\"video\":\"nfx:mainnet:1:salt-flats-dusk\",\"session\":\"0123456789abcdef0123456789abcdef\"}",
      "message": {
        "t": "hello",
        "video": "nfx:mainnet:1:salt-flats-dusk",
        "session": "0123456789abcdef0123456789abcdef"
      }
    },
    {
      "name": "quote",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":1,\"mints\":[\"https://mint.example\"],\"window\":8}",
      "message": {
        "t": "quote",
        "price_per_chunk": 1,
        "mints": [
          "https://mint.example"
        ],
        "window": 8
      }
    },
    {
      "name": "quote-loopback-mint",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":2,\"mints\":[\"http://127.0.0.1:3338\"],\"window\":1}",
      "message": {
        "t": "quote",
        "price_per_chunk": 2,
        "mints": [
          "http://127.0.0.1:3338"
        ],
        "window": 1
      }
    },
    {
      "name": "pay",
      "wire": "{\"t\":\"pay\",\"upto_chunk\":17,\"token\":\"cashuBexampletoken\"}",
      "message": {
        "t": "pay",
        "upto_chunk": 17,
        "token": "cashuBexampletoken"
      }
    },
    {
      "name": "ack",
      "wire": "{\"t\":\"ack\",\"accepted_upto\":17,\"spent_total\":17}",
      "message": {
        "t": "ack",
        "accepted_upto": 17,
        "spent_total": 17
      }
    },
    {
      "name": "rej",
      "wire": "{\"t\":\"rej\",\"code\":\"underpaid\",\"detail\":\"short by 2 sat\"}",
      "message": {
        "t": "rej",
        "code": "underpaid",
        "detail": "short by 2 sat"
      }
    },
    {
      "name": "rej-unknown-code-no-detail",
      "wire": "{\"t\":\"rej\",\"code\":\"some-future-code\"}",
      "message": {
        "t": "rej",
        "code": "some-future-code"
      }
    },
    {
      "name": "hello-unknown-field",
      "wire": "{\"t\":\"hello\",\"video\":\"nfx:mainnet:1:salt-flats-dusk\",\"session\":\"0123456789abcdef0123456789abcdef\",\"x-future\":1}",
      "message": {
        "t": "hello",
        "video": "nfx:mainnet:1:salt-flats-dusk",
        "session": "0123456789abcdef0123456789abcdef"
      }
    },
    {
      "name": "max-safe-integer",
      "wire": "{\"t\":\"ack\",\"accepted_upto\":9007199254740991,\"spent_total\":0}",
      "message": {
        "t": "ack",
        "accepted_upto": 9007199254740991,
        "spent_total": 0
      }
    }
  ],
  "invalid": [
    {
      "name": "not-json",
      "wire": "hello",
      "why": "not JSON"
    },
    {
      "name": "not-an-object",
      "wire": "[1,2]",
      "why": "not an object"
    },
    {
      "name": "no-t",
      "wire": "{\"video\":\"nfx:mainnet:1:salt-flats-dusk\",\"session\":\"0123456789abcdef0123456789abcdef\"}",
      "why": "missing t"
    },
    {
      "name": "unknown-t",
      "wire": "{\"t\":\"tip\",\"amount\":1}",
      "why": "unknown t"
    },
    {
      "name": "session-short",
      "wire": "{\"t\":\"hello\",\"video\":\"nfx:mainnet:1:salt-flats-dusk\",\"session\":\"0123456789abcdef0123456789abcde\"}",
      "why": "session is 32 lowercase hex"
    },
    {
      "name": "session-uppercase",
      "wire": "{\"t\":\"hello\",\"video\":\"nfx:mainnet:1:salt-flats-dusk\",\"session\":\"0123456789ABCDEF0123456789ABCDEF\"}",
      "why": "session is 32 lowercase hex"
    },
    {
      "name": "bad-video",
      "wire": "{\"t\":\"hello\",\"video\":\"mainnet:salt\",\"session\":\"0123456789abcdef0123456789abcdef\"}",
      "why": "video is an NFX address"
    },
    {
      "name": "quote-no-mints",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":1,\"mints\":[],\"window\":8}",
      "why": "mints is 1 to 16 URLs"
    },
    {
      "name": "quote-17-mints",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":1,\"mints\":[\"https://m0.example\",\"https://m1.example\",\"https://m2.example\",\"https://m3.example\",\"https://m4.example\",\"https://m5.example\",\"https://m6.example\",\"https://m7.example\",\"https://m8.example\",\"https://m9.example\",\"https://m10.example\",\"https://m11.example\",\"https://m12.example\",\"https://m13.example\",\"https://m14.example\",\"https://m15.example\",\"https://m16.example\"],\"window\":8}",
      "why": "mints is 1 to 16 URLs"
    },
    {
      "name": "quote-http-mint",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":1,\"mints\":[\"http://mint.example\"],\"window\":8}",
      "why": "mint must be https (or loopback http)"
    },
    {
      "name": "quote-price-zero",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":0,\"mints\":[\"https://mint.example\"],\"window\":8}",
      "why": "price_per_chunk >= 1"
    },
    {
      "name": "quote-window-zero",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":1,\"mints\":[\"https://mint.example\"],\"window\":0}",
      "why": "window >= 1"
    },
    {
      "name": "quote-float",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":1.5,\"mints\":[\"https://mint.example\"],\"window\":8}",
      "why": "integers only"
    },
    {
      "name": "quote-negative",
      "wire": "{\"t\":\"quote\",\"price_per_chunk\":-1,\"mints\":[\"https://mint.example\"],\"window\":8}",
      "why": "non-negative"
    },
    {
      "name": "pay-upto-zero",
      "wire": "{\"t\":\"pay\",\"upto_chunk\":0,\"token\":\"cashuBx\"}",
      "why": "upto_chunk >= 1"
    },
    {
      "name": "pay-no-token",
      "wire": "{\"t\":\"pay\",\"upto_chunk\":3}",
      "why": "missing token"
    },
    {
      "name": "pay-not-cashu",
      "wire": "{\"t\":\"pay\",\"upto_chunk\":3,\"token\":\"lnbc1...\"}",
      "why": "token is a NUT-00 token"
    },
    {
      "name": "ack-missing",
      "wire": "{\"t\":\"ack\",\"accepted_upto\":3}",
      "why": "missing spent_total"
    },
    {
      "name": "rej-no-code",
      "wire": "{\"t\":\"rej\",\"detail\":\"x\"}",
      "why": "missing code"
    },
    {
      "name": "rej-long-detail",
      "wire": "{\"t\":\"rej\",\"code\":\"stale\",\"detail\":\"\"}",
      "why": "detail at most 1 KiB"
    },
    {
      "name": "beyond-2^53",
      "wire": "{\"t\":\"ack\",\"accepted_upto\":9007199254740992,\"spent_total\":0}",
      "why": "integers at most 2^53-1"
    },
    {
      "name": "over-32-KiB",
      "wire": "{\"t\":\"pay\",\"upto_chunk\":1,\"token\":\"\"}",
      "why": "a line is at most 32 KiB"
    }
  ]
}
