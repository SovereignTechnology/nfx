{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovit.xyz/nfx/spec/schemas/hashlist.schema.json",
  "title": "NFX-05 hash list",
  "type": "object",
  "additionalProperties": true,
  "required": ["v", "video", "files", "renditions"],
  "properties": {
    "v": { "const": 1 },
    "video": {
      "type": "string",
      "pattern": "^nfx:[a-z0-9-]{2,32}:(0|[1-9][0-9]*):[a-z0-9][a-z0-9-]{6,62}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "role", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["playlist-master", "playlist", "init", "segment", "thumb", "subtitle"]
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "dur_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "renditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "playlist", "bandwidth"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "not": { "const": "meta" } },
          "playlist": { "type": "string", "minLength": 1 },
          "bandwidth": { "type": "integer", "minimum": 1 },
          "codecs": { "type": "string" },
          "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" }
        }
      }
    }
  }
}
